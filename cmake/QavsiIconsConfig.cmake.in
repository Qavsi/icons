@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.12 COMPONENTS Quick)
set_and_check(QavsiIcons_QML_IMPORT_DIR "@PACKAGE_qml_install_dir@")
include("${CMAKE_CURRENT_LIST_DIR}/QavsiIconsCoreTargets.cmake")
set(QavsiIcons_Core_FOUND TRUE)
if(NOT TARGET QavsiIconsCorePlugin)
    add_library(QavsiIconsCorePlugin ALIAS QavsiIcons::CorePlugin)
endif()
foreach(component IN LISTS QavsiIcons_FIND_COMPONENTS)
    if(component STREQUAL "Material" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/QavsiIconsMaterialTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/QavsiIconsMaterialTargets.cmake")
        set(QavsiIcons_Material_FOUND TRUE)
        if(NOT TARGET QavsiIconsMaterialPlugin)
            add_library(QavsiIconsMaterialPlugin ALIAS QavsiIcons::MaterialPlugin)
        endif()
    elseif(NOT component STREQUAL "Core")
        set(QavsiIcons_${component}_FOUND FALSE)
        set(QavsiIcons_NOT_FOUND_MESSAGE "Unavailable QavsiIcons component: ${component}")
    endif()
endforeach()
check_required_components(QavsiIcons)
