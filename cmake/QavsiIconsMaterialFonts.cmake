include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/QavsiIconsFonts.cmake")

function(qavsi_icons_add_material_fonts target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "ALL;VARIABLE" "" "ICONS")
    if(arg_UNPARSED_ARGUMENTS OR (arg_ALL AND arg_ICONS) OR (NOT arg_ALL AND NOT arg_ICONS))
        message(FATAL_ERROR "Choose ICONS <names...> or ALL, optionally with VARIABLE")
    endif()
    if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/Qavsi/Icons/Material/fonts/MaterialSymbolsRounded.codepoints")
        set(font_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/Qavsi/Icons/Material/fonts")
    else()
        set(font_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/material-fonts")
    endif()
    set(fonts "${font_dir}/MaterialSymbolsRoundedOutline.ttf" "${font_dir}/MaterialSymbolsRoundedFilled.ttf")
    if(arg_VARIABLE)
        list(APPEND fonts "${font_dir}/MaterialSymbolsRounded.ttf")
    endif()
    if(arg_ALL)
        set(selection ALL)
    else()
        set(catalog "${font_dir}/MaterialSymbolsRounded.codepoints")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog}")
        file(STRINGS "${catalog}" lines)
        foreach(name IN LISTS arg_ICONS)
            set(found FALSE)
            foreach(line IN LISTS lines)
                if(line MATCHES "^${name} ([0-9a-fA-F]+)$")
                    list(APPEND codepoints "${CMAKE_MATCH_1}")
                    set(found TRUE)
                    break()
                endif()
            endforeach()
            if(NOT found)
                message(FATAL_ERROR "Unknown Material icon or keyword: ${name}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES codepoints)
        set(selection CODEPOINTS ${codepoints})
    endif()
    _qavsi_icons_add_font_resources(${target} QRC_PREFIX "/qt/qml/Qavsi/Icons/Material/fonts"
        FONTS ${fonts} ${selection})
endfunction()
